# Copy to .env and adapt. The .env file is ignored by Git: never commit real values.
# Every value below has a working local default in config/app.yaml unless marked REQUIRED.

# --- Application -------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# --- Kafka -------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_HOST_PORT=9094

# --- Event generator ---------------------------------------------------------
PRODUCER_EVENTS_PER_SECOND=50
PRODUCER_INVALID_RATIO=0.05
PRODUCER_DUPLICATE_RATIO=0.02
PRODUCER_LATE_RATIO=0.03

# --- Spark Structured Streaming ----------------------------------------------
STREAMING_TRIGGER_INTERVAL="30 seconds"

# --- Storage: local | s3 | gcs -----------------------------------------------
STORAGE_BACKEND=local

# Only with STORAGE_BACKEND=s3 (build images with INSTALL_CLOUD_CONNECTORS=true)
S3_BUCKET=
S3_PREFIX=lakehouse
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Only with STORAGE_BACKEND=gcs (build images with INSTALL_CLOUD_CONNECTORS=true)
GCS_BUCKET=
GCS_PREFIX=lakehouse
GOOGLE_APPLICATION_CREDENTIALS=

# --- Image build -------------------------------------------------------------
INSTALL_CLOUD_CONNECTORS=false

# --- Airflow -----------------------------------------------------------------
# Same UID as the Spark image, so both can write to the shared lakehouse volume.
AIRFLOW_UID=1000
POSTGRES_USER=airflow
# REQUIRED: choose a local password.
POSTGRES_PASSWORD=
POSTGRES_DB=airflow
# REQUIRED: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
# REQUIRED: python -c "import secrets; print(secrets.token_urlsafe(48))"
AIRFLOW_JWT_SECRET=

# --- Grafana -----------------------------------------------------------------
# Change it when port 3000 is already used on the host.
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
# REQUIRED: choose a local password.
GRAFANA_ADMIN_PASSWORD=
