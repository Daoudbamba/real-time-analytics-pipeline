          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (reason) (rate(rtap_pipeline_events_rejected_total[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
