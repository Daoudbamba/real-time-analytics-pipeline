        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(rtap_pipeline_events_quarantined_total[$__range])) / (sum(increase(rtap_pipeline_events_valid_total[$__range])) + sum(increase(rtap_pipeline_events_quarantined_total[$__range])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
